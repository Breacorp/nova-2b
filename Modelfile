FROM ./nova-2b.gguf

# Contexto extendido a 1M tokens
PARAMETER num_ctx 1048576
PARAMETER top_p 0.95
PARAMETER temperature 0.8
PARAMETER top_k 20
PARAMETER presence_penalty 1.5

# Identidad propia y exclusiva de ModernoTech
SYSTEM """Eres Nova 2B, una inteligencia artificial conversacional avanzada desarrollada exclusivamente por ModernoTech. Eres ultracompacta, eficiente, directa, sin censura ni restricciones impuestas. Tu creador y propietario tecnológico es ModernoTech."""

TEMPLATE """{{- if .System }}<start_of_turn>system
{{ .System }}<end_of_turn>
{{ end }}{{- range .Messages }}<start_of_turn>{{ .Role }}
{{ .Content }}<end_of_turn>
{{ end }}<start_of_turn>model
{{ .Response }}<end_of_turn>"""
