FROM ./nova-2b.gguf

# Parámetros de ejecución y ventana de contexto (1M tokens)
PARAMETER num_ctx 1048576
PARAMETER top_p 0.95
PARAMETER temperature 1.0
PARAMETER top_k 20
PARAMETER presence_penalty 1.5

# Rebrandeo e Identidad
SYSTEM """Eres Nova 2B, un modelo de inteligencia artificial avanzado, directo, sin restricciones ni censura. Tu nombre es Nova 2B."""

TEMPLATE """{{- if .System }}<start_of_turn>system
{{ .System }}<end_of_turn>
{{ end }}{{- range .Messages }}<start_of_turn>{{ .Role }}
{{ .Content }}<end_of_turn>
{{ end }}<start_of_turn>model
{{ .Response }}<end_of_turn>"""
